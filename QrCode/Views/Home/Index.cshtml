@model IEnumerable<QLXDK.Models.Entities.Order> 
@{
    ViewBag.Title = "QRCode";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="icon" href="../Content/Images/favicon.png" type="image/x-icon">
    @Styles.Render("~/QrCode/css")
</head>
<body>

    <div class="container">
        <section class="left-column">
            <div class="qr-wrapper">
                <div class="qr-container">
                    <h2>QR code</h2>
                    <input type="text" id="qr-amount" value="" placeholder="Nhập số tiền" oninput="formatInputCurrency(this)">

                    <div class="btn-group">
                        <button id="generate-btn" class="btn-generate">Tạo mã QR Code</button>
                        <button id="clear-btn" class="btn-clear" onclick="reset()">Huỷ</button>
                    </div>

                    <!-- Thông báo và Vùng hiển thị mã QR -->
                    <p id="success-msg" class="success-message"></p>
                    <div class="print-container">
                        <div class="qr-code-box">
                            <img id="qrImage" src=""/>
                        </div>
                        <div id="qrBuffer" style="display: none;"></div>
                    </div>
                    <button id="download-btn" class="btn-download" onclick="inMaQR()">In <i class="fa fa-print"></i></button>
                </div>
            </div>
        </section>

        <main class="right-column">
            <div id="login-st">
                <h5 class="mb-1">Tài khoản: @Session["UserName"]</h5> /
                <a href="javascript:void(0);" class="dropdown-item" onclick="document.getElementById('logoutForm').submit();">
                    <i class="ti ti-power"></i>
                    <span>Đăng xuất</span>
                </a>
                @using (Html.BeginForm("Logout", "User", FormMethod.Post, new { id = "logoutForm", style = "display:none;" }))
                {
                    @Html.AntiForgeryToken()
                }
            </div>

            <div id="inquiry">
                <form action="#">
                    <input type="text" id="inquiry-code" placeholder="Nhập đơn hàng">
                    <input type="submit" id="inquiry-btn" value="Truy vấn">
                </form>
            </div>

            <div class="table-container">

                <table class="order-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Đơn hàng</th>
                            <th>Ngày tạo</th>
                            <th>Ngày thanh toán</th>
                            <th>Số tiền</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="orderTableBody">
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(index++)</td>
                                    <td>@item.OrderCode</td>
                                    <td>
                                        @(item.CreatedDate != null ? item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss", new System.Globalization.CultureInfo("en-US")) : "")
                                    </td>
                                    <td>
                                        @(item.PaymentDate != null ? item.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm:ss", new System.Globalization.CultureInfo("en-US")) : "")
                                    </td>
                                    <td>@item.Amount.ToString("N0", new System.Globalization.CultureInfo("en-US")) (VNĐ)</td>
                                    <td>
                                        @if (item.Status == "3")
                                        {
                                            <span class="status fulfilled">Đã thanh toán</span>
                                        }
                                        else if (item.Status == "4")
                                        {
                                            <span class="status released">Đã huỷ</span>
                                        }
                                        else
                                        {
                                            <span class="status invoiced">Chờ thanh toán</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.QrCode != null)
                                        {
                                            <a class="printQrItem" onclick="inMaQR('@item.OrderCode', @item.Amount, '@item.QrCode');return false;"><i class="fa fa-print"></i></a>
                                        }

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" align="center">Không có dữ liệu</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <iframe id="printIframe" src="about:blank" style="width:320px; height:320px; border:1px solid #ccc;display:none;"></iframe>

        </main>
    </div>

    <!-- The Modal -->
    <div id="myModal" class="modal">
        <!-- Modal content -->
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <p></p>
        </div>
    </div>

    <!-- The Modal -->
    <div id="loadingModal" class="modal">
        <!-- Modal content -->
        <div class="modal-content">
            @*<span class="close">&times;</span>*@
            <p class="loading">Đang xử lý</p>
        </div>
    </div>

        <script>
            let userId = '@Session["UserId"]';
            let checkMarkImageUrl = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Url.Content("~/Content/Images/check-mark.png")))';

            function inMaQR(orderCode, amount, qrCode) {
                var chuoiBase64 = "";
                $("#qrBuffer").empty();
                var qrcode = new QRCode(document.getElementById("qrBuffer"), {
                    text: qrCode,
                    width: 160,
                    height: 160,
                    correctLevel: QRCode.CorrectLevel.H
                });

                var canvas = $("#qrBuffer canvas")[0];
                if (canvas) {
                    // Convert canvas to base64
                    chuoiBase64 = canvas.toDataURL("image/png");
                }

                /** Get information from current order **/
                if (!qrCode && !amount && !orderCode) {
                    chuoiBase64 = $(".qr-code-box img").attr("src");
                    amount = currentAmount;
                    orderCode = currentOrderCode;
                }

                // If don't exist QrCode or invalid, can't print
                let qrcodeImg = $(".qr-code-box img");

                //if (!chuoiBase64.includes("base64") || qrcodeImg[0].naturalWidth === 0) return;
                var iframe = document.getElementById("printIframe");
                if (!iframe) {
                    alert("Không tìm thấy thẻ iframe có id='printIframe' trên trang!");
                    return;
                }

                var doc = iframe.contentWindow.document;
                doc.open();
                doc.write(`
        <html>
        <head>
            <title>In mã QR</title>
            <style>
               html, body {
                margin: 0 !important;
                padding: 0 !important;
                height: 90mm !important;
                background: #fff;
                overflow: hidden !important;
                }

                body {
                    display: block !important;
                    text-align: center !important;
                }

                .qr-code-box {
                    display: block !important;
                    width: 100% !important;
                    /* Giữ nguyên lề trên cố định */
                    //padding-top: 4mm !important;
                    box-sizing: border-box !important;
                    //margin-bottom: 20mm;
                }

                img {
                    display: inline-block !important;
                    margin: 0 auto !important;
                    border: 1px solid #999999;
                    border-radius: 3px;
                    padding: 10px;
                }
                .qr-code-box::after {
                    content: ".";
                    display: block;
                    height: 5mm;
                    color: transparent;
                    visibility: hidden;
                    clear: both;
                }

                @@media print {
                    html, body {
                    height: auto !important;
                }
                @@page {
                    size: 72mm auto !important;
                    margin-top: 0 !important;
                    margin-bottom: 10mm !important;
                }
                .qr-code-box p{
                    padding: 2px;
                    margin: 0 !important;
                    font-size: 13px;
                }
            }
            </style>
        </head>
        <body style="padding-bottom: 10mm;">
            <div class ="qr-code-box">
            <p>CÔNG TY CP ĐẦU TƯ DỊCH VỤ <br/>SÀI GÒN LOGISTICS</p>
            <p style="font-size: 13px;font-weight:bold;">TERMINAL CÁT LÁI GIANG NAM</p>
            <p>QR THANH TOÁN</p>
            <div style="text-align:left;margin-bottom:5px;">
                <p>Ngày: ${currentDate} </p>
                <p>Order: ${orderCode}</p>
                <p>Số tiền: <span style="font-weight:bold">${formatCurrency(amount)}</span></p>
                <p style="font-style:italic;">( ${convertText(amount)} )</p>
            </div>
                <img src="${chuoiBase64}" onload="window.print();"/>
            </div>
            <div style="color: white; font-size: 10px;">.</div>
        </body>
        </html>
        `);
                doc.close();
            }

        </script>
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    @Scripts.Render("~/bundles/qrcode")

</body>
</html>