    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/customjs")
    <script src="~/Scripts/bootstrap.min.js"></script>
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")


    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>

        $(document).ready(function () {
            $.validator.setDefaults({
                ignore: [] // Validates all hidden elements, including Select2
            });
            //$('select').on('select2:select', function (e) {
            //    $(this).valid(); // Re-validates the field immediately after selection
            //});

            $('.select2').select2();
            $('.select2').on('change', function () {
                //console.log('1111')
                $(this).valid();
            });
            var validator = $('#form-booking').validate({ ignore: null });

        });

        $(".sailing-date, .vgm-closing-date").flatpickr({
            //enableTime: true,
            dateFormat: "d/m/Y",
            onChange: function (selectedDates, dateStr, instance) {
                // Re-validate the field whenever the date changes
                $(instance.element).valid();
            }
        });
        $('.sailing-date, .closing-date, .vgm-closing-date, .sl-closing-time').removeAttr('data-val-date');
        $(".closing-date, .sl-closing-time").flatpickr({
            enableTime: true,
            dateFormat: "d/m/Y H:i",
            onChange: function (selectedDates, dateStr, instance) {
                // Re-validate the field whenever the date changes
                $(instance.element).valid();
            }
        });
        $(".vgm-closing-time").flatpickr({
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true
        });
        //flatpickr(".closing-date", {
        //    onChange: function (selectedDates, dateStr, instance) {
        //        // Your code here
        //        //console.log("Selected dates:", selectedDates); // Array of Date objects
        //        //console.log("Date string:", dateStr);          // Formatted date string
        //        $(this).valid();
        //    }
        //});
    </script>
    @RenderSection("scripts", required: false)


