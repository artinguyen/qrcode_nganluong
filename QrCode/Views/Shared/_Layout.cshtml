    <!-- [ Main Content ] start -->
    <section class="pc-container">
        <div class="pc-content">
            <!-- [ breadcrumb ] start -->
            <div class="page-header">
                <div class="page-block">
                    <div class="row align-items-center">
                        <div class="col-md-12">
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="">Trang chủ</a></li>
                                <li class="breadcrumb-item"><a href="/@ViewContext.RouteData.Values["controller"].ToString()">@ViewBag.Title</a></li>
                                @if (ViewBag.Action != null)
                                {
                                    <li class="breadcrumb-item" aria-current="page">@ViewBag.Action</li>
                                }
                                @*<li class="breadcrumb-item" aria-current="page">Form Basic</li>*@
                            </ul>
                        </div>
                        @*<div class="col-md-12">
                                <div class="page-header-title">
                                    <h2 class="mb-0">Form Basic</h2>
                                </div>
                            </div>*@
                    </div>
                </div>
            </div>
            <!-- [ breadcrumb ] end -->

            <div class="row">

                @RenderBody()

            </div>
        </div>
        <!-- [ Main Content ] end -->
    </section>







    <footer class="pc-footer">
        <div class="footer-wrapper container-fluid">
            <div class="row">
                <div class="col-sm my-1 text-center">
                    <p class="m-0">©Copy right 2026</p>
                </div>

            </div>
        </div>
    </footer> <!-- Required Js -->
